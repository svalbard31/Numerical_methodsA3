import matplotlib.pyplot as plt
import numpy as np
from scipy.integrate import solve_ivp

g=9.81
l=1
y1_0=np.pi*0.5
y2_0=0
A=1
d=0.5
y = np.array([y1_0, y2_0])

def theta(t,y):
    y1 = y[0]
    y2 = y[1]
    return [y2, A*np.sin(t)-d*y2-g/l*np.sin(y1)]

solution = solve_ivp(theta, [0, 20], [y1_0, y2_0], t_eval=np.linspace(0, 20, 100))

plt.plot(solution.t, solution.y[0])
plt.xlabel("Time (s)")
plt.ylabel("Angle (rad)")
plt.grid()
plt.show()
